#!/usr/bin/env bash
# Quick-Tide Search Launcher (PyQt6 + QML)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
SHARE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ ! -f "$SHARE_DIR/search_gui.py" ]; then
    SHARE_DIR="$HOME/.local/share/quick-tide"
    [ ! -f "$SHARE_DIR/search_gui.py" ] && SHARE_DIR="$HOME/.local/share/tidal-gui"
fi

exec python3 "$SHARE_DIR/search_gui.py" "$@"
